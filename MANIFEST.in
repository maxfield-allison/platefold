include changes/.gitkeep
include requirements-runtime.txt requirements-build.txt uv.lock setup.bat
include packaging/rust-toolchain-downloads.json
# Tools and tests are listed by name, not by pattern: a new file stays out of
# the source distribution until it is added here. setuptools adds every
# tests/test*.py on its own, so that default is removed first.
