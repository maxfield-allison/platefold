{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlateFold",
  "version": "1.0.1",
  "identifier": "dev.probablyfine.platefold",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Plate|Fold",
        "width": 1280,
        "height": 700,
        "minWidth": 640,
        "minHeight": 420,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Documents to PDF with every figure on a page that fits.",
    "category": "Productivity",
    "licenseFile": "../../LICENSE",
    "resources": { "runtime/": "runtime/" },
    "macOS": {
      "minimumSystemVersion": "15.1"
    },
    "windows": {
      "webviewInstallMode": { "type": "offlineInstaller" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "../../packaging/windows-hooks.nsh",
        "displayLanguageSelector": false,
        "compression": "zlib"
      }
    }
  }
}
